modules = ["nodejs-20", "web", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["poppler_utils"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "gce"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]
ignorePorts = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "core-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "visual-regression"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "core-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check && npm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "visual-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:visual:unit && npm run test:visual"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "script/post-merge.sh"
timeoutMs = 240000
